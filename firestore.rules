rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isUser(userId) { return isSignedIn() && request.auth.uid == userId; }
    function role() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "student")
        : "anonymous";
    }
    function isAdmin() { return role() == "admin" || role() == "superadmin"; }
    function isStaff() { return role() == "staff"; }
    function isStaffOrAdmin() { return isAdmin() || isStaff(); }
    function tenantAllowed(tenantId) {
      return isAdmin() ||
        (isStaff() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("tenantId", "") == tenantId);
    }

    // 1. Users
    match /users/{userId} {
      allow read: if isUser(userId) || isStaffOrAdmin();
      allow create: if isAdmin();
      allow update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
      match /assessmentAttempts/{attemptId} { allow read, write: if isUser(userId) || isStaffOrAdmin(); }
      match /contestAttempts/{attemptId}    { allow read, write: if isUser(userId) || isStaffOrAdmin(); }
      match /multiSectionAttempts/{attemptId} { allow read, write: if isUser(userId) || isStaffOrAdmin(); }
    }

    // 2. Tenants / Colleges - public read for Guest Portal gateKey fetch
    match /tenants/{tenantId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (isStaff() && tenantAllowed(tenantId));
      allow delete: if isAdmin();
      match /cohorts/{cohortId} {
        allow read: if true;
        allow write: if isAdmin() || (isStaff() && tenantAllowed(tenantId));
      }
    }

    // 3. Courses hierarchy
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /series/{seriesId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
        match /tests/{testId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();
        }
      }
    }

    // 4. Assessments (MCQ / Coding / SEA question sets)
    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Assessment Results (v2 canonical path)
    match /assessmentResults/{testId} {
      allow read: if isStaffOrAdmin();
      allow write: if false;
      match /students/{userId} {
        allow read: if isUser(userId) || isStaffOrAdmin();
        allow create: if isSignedIn();
        allow update: if isUser(userId) || isStaffOrAdmin();
        allow delete: if isAdmin();
      }
      match /guests/{guestId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // 6. Question Bank
    match /questionBank/{bankId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // 7. MCQ Banks
    match /mcqBanks/{bankId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // 8. Coding Bank
    match /codingBank/{challengeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 9. Contest Attempts (SEB coding sandbox)
    match /contestAttempts/{attemptId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isStaffOrAdmin();
    }

    // 10. Multi-Section Attempts (MSA)
    match /multiSectionAttempts/{attemptId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isStaffOrAdmin();
    }

    // 11. Live Assessment Monitor
    match /liveAssessments/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isStaffOrAdmin();
    }

    // 12. Live Presence
    match /livePresence/{dateStr}/sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isStaffOrAdmin();
    }

    // 13. System Config
    match /systemConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 14. User API Keys
    match /userApiKeys/{userEmail} {
      allow read, write: if isSignedIn() && request.auth.token.email == userEmail;
      allow read, delete: if isAdmin();
    }

    // 15. Content URLs
    match /contentUrls/{slugId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 16. Tenant Courses - per-college test registry (public read for guest portal)
    match /tenantCourses/{tenantId} {
      allow read: if true;
      allow write: if false;
      match /tests/{testId} {
        allow read: if true;
        allow write: if isAdmin() || (isStaff() && tenantAllowed(tenantId));
        allow delete: if isAdmin() || (isStaff() && tenantAllowed(tenantId));
      }
    }

    // 17. Tenant Results - per-college denormalized results for staff reports
    match /tenantResults/{tenantId} {
      allow read: if isStaffOrAdmin();
      allow write: if false;
      match /results/{resultId} {
        allow read: if isStaffOrAdmin();
        allow create: if true;
        allow update, delete: if isAdmin() || (isStaff() && tenantAllowed(tenantId));
      }
    }

    // 18. Question Tracker
    match /questionTracker/{courseId}/{seriesId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 19. Staff Profiles
    match /staffProfiles/{userId} {
      allow read: if isStaffOrAdmin();
      allow write: if isAdmin();
    }

    // 20. Legacy Paths (backward compat)
    match /AssessmentResults/{testId}/colleges/{college}/years/{year}/students/{email} {
      allow read, write: if isSignedIn();
    }
    match /colleges/{college}/years/{year}/departments/{dept}/students/{email}/{resultType}/{testId} {
      allow read, write: if isSignedIn();
    }
    match /LiveUsers/{dateStr}/colleges/{college}/years/{year}/users/{email} {
      allow read, write: if isSignedIn();
    }
  }
}