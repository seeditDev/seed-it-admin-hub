rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// SEED-IT Platform — Master Firestore Security Rules  v3.0
//
// Shared by:
//   • SEED Admin Portal  (seed-it-admin-hub)
//   • SEED SEB Platform  (seed-seb / seed-website-desktop-edition)
//
// Security model:
//   superadmin/admin  → full access to all collections
//   staff             → read/write scoped to myTenant(); portal reads
//   student           → own profile + assigned content + own attempt + own result
//   guest             → publicTenants + guestEnabled test cards + own guest result
//   unauthenticated   → publicTenants ONLY
//
// UNRESOLVED LIMITATION (requires Cloud Function):
//   assessmentResults/{assessmentId}/students/{uid} score fields are written
//   CLIENT-SIDE. Rules enforce ownership and lifecycle semantics but cannot
//   validate the arithmetic. A Cloud Function is required for trusted scoring.
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ──────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.token.email == userId
      );
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return hasProfile()
        ? myProfile().role
        : (isSignedIn() ? request.auth.token.get('role', 'none') : 'none');
    }

    function isAdmin() {
      return myRole() == 'admin' || myRole() == 'superadmin';
    }

    function isStaff() {
      return myRole() == 'staff';
    }

    function isPortal() {
      return isAdmin() || isStaff();
    }

    function myTenant() {
      return hasProfile() ? myProfile().get('tenantId', '') : '';
    }

    function tenantAllowed(tenantId) {
      return isAdmin() || (isStaff() && tenantId == myTenant());
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && (isPortal() || myTenant() == tenantId);
    }

    // ══════════════════════════════════════════════════════════════════════
    // 1. Users   users/{uid}
    // ══════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      allow get:    if isUser(userId) || isPortal();
      allow list:   if isPortal();

      allow create: if isAdmin()
        || (isStaff()
            && request.resource.data.role == 'student'
            && request.resource.data.tenantId == myTenant())
        || (isUser(userId)
            && request.resource.data.role == 'student');

      allow update: if isAdmin()
        || (isStaff() && tenantAllowed(resource.data.tenantId)
            && request.resource.data.role == resource.data.role)
        || (isUser(userId)
            && request.resource.data.role     == resource.data.role
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.get('premium', false)
               == resource.data.get('premium', false));

      allow delete: if isAdmin();

      // Active exam session — student writes their own; portal reads
      match /contestAttempts/{attemptId} {
        allow read: if isUser(userId) || isPortal();
        allow create: if isUser(userId);
        allow update: if isPortal()
          || (isUser(userId)
              && !(resource.data.get('completed', false) == true
                   && request.resource.data.get('completed', false) == false));
        allow delete: if isPortal();
      }

      // Completed summary mirror
      match /assessmentAttempts/{attemptId} {
        allow read, write: if isUser(userId) || isPortal();
      }

      // Practice / course progress
      match /courseProgress/{courseId} {
        allow read, write: if isUser(userId) || isPortal();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 2. CollectionGroup: contestAttempts (Live Monitor)
    // All types use users/{uid}/contestAttempts/{assessmentId}.
    // path[1] == uid.
    // ══════════════════════════════════════════════════════════════════════

    match /{path=**}/contestAttempts/{attemptId} {
      allow read:   if isPortal() || (isSignedIn() && isUser(path[1]));
      allow create: if isSignedIn() && isUser(path[1]);
      allow update: if isPortal()
        || (isSignedIn() && isUser(path[1])
            && !(resource.data.get('completed', false) == true
                 && request.resource.data.get('completed', false) == false));
      allow delete: if isPortal();
    }

    // multiSectionAttempts — LEGACY read-only
    match /{path=**}/multiSectionAttempts/{attemptId} {
      allow read:  if isPortal() || (isSignedIn() && isUser(path[1]));
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // 3. Tenants & Cohorts  (PRIVATE — portal only)
    // Guests use publicTenants instead.
    // ══════════════════════════════════════════════════════════════════════

    match /tenants/{tenantId} {
      allow read:           if isPortal();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();

      match /cohorts/{cohortId} {
        // Cohorts are readable publicly — Guest Portal uses gateKey to validate
        // cohort entry without Firebase Auth. Cohort docs contain only UI-gate
        // fields (label, year, gateKey, allowedModules) — no admin secrets.
        allow read:   if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (isStaff() && tenantId == myTenant());
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 4. Public Tenant Projection  publicTenants/{tenantId}
    // Contains only: { name, slug, active }
    // Written by Admin Hub on tenant save. Readable by guests without auth.
    // ══════════════════════════════════════════════════════════════════════

    match /publicTenants/{tenantId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 5. Courses / Series / Tests
    // SEB reads via getAllowedTests() — specific test docs by courseId+seriesId.
    // Students must be signed in; unauthenticated guests use tenantCourses.
    // ══════════════════════════════════════════════════════════════════════

    match /courses/{courseId} {
      allow read:               if isSignedIn();
      allow create, update, delete: if isPortal();

      match /series/{seriesId} {
        allow read:               if isSignedIn();
        allow create, update, delete: if isPortal();

        match /tests/{testId} {
          allow read:               if isSignedIn();
          allow create, update, delete: if isPortal();
        }

        match /_meta/{trackerId} {
          allow read:  if isPortal();
          allow write: if isPortal();
        }
      }
    }

    // CollectionGroup: tests
    //
    // P0 FIX: The previous wildcard `/{path=**}/tests/{testId}` with
    // `allow read: if isSignedIn()` made EVERY test document (including
    // unassigned/draft tests under any parent) readable by any authenticated
    // user. This overrode the more specific courses/{c}/series/{s}/tests/{t}
    // rule that should gate access.
    //
    // Correct model:
    //   - Signed-in users may read tests ONLY via the scoped path:
    //       courses/{c}/series/{s}/tests/{t}   (line 195-198 above)
    //   - Guest users may read tenantCourses/{tenantId}/tests/{t} where
    //       guestEnabled == true                (line 228-236 above)
    //   - Portal (admin/staff) may read all tests for the authoring UI
    //
    // This collectionGroup rule is kept ONLY for portal-level queries
    // (e.g., "find all tests using assessment X").
    match /{path=**}/tests/{testId} {
      allow read: if isPortal();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 6. Tenant Courses — assignment registry
    //   tenantCourses/{tenantId}/tests/{testId}
    //
    // Authenticated students read OWN tenant only.
    // Unauthenticated guests may read where guestEnabled == true.
    // Passkey limitation: passkey is in the doc; this is a known UI-gate
    // limitation (not a cryptographic secret).
    // ══════════════════════════════════════════════════════════════════════

    match /tenantCourses/{tenantId} {
      allow read:  if isPortal() || isTenantMember(tenantId);
      allow write: if isPortal();

      match /tests/{testId} {
        allow read: if isPortal()
          || isTenantMember(tenantId)
          || resource.data.guestEnabled == true;
        allow create, update: if isAdmin()
          || (isStaff() && tenantAllowed(tenantId));
        allow delete: if isAdmin()
          || (isStaff() && tenantAllowed(tenantId));
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 7. Assessments (admin authoring store)
    // Students may get() by ID (schedule check) but must NOT list all.
    // Draft assessments are blocked for non-portal users.
    // ══════════════════════════════════════════════════════════════════════

    match /assessments/{assessmentId} {
      // Portal: full read access for authoring UI
      allow list: if isPortal();
      allow create, update, delete: if isPortal();

      // get() — scoped by role:
      //   Admin/Staff: all assessments including drafts
      //   Student/SEB: only published (active) assessments
      //     SEB resolves tests from courses/{c}/series/{s}/tests/{t} which
      //     stores cdnUrl; it should not need to read the raw assessment doc.
      //     However if SEB does get() for validation, it must only see active.
      allow get: if isPortal()
        || (isSignedIn() && resource.data.get('status', 'draft') == 'active');

      match /{document=**} {
        allow read:  if isPortal();
        allow write: if isPortal();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 8. Assessment Results  (authoritative finalized store)
    //   assessmentResults/{assessmentId}/{tenantId}/students/{uid}
    //   assessmentResults/{assessmentId}/{tenantId}/guests/{guestId}
    //
    // tenantId is the student's college code (e.g. "KGKITE").
    // LIMITATION: Score fields are client-authoritative (no Cloud Function).
    // ══════════════════════════════════════════════════════════════════════

    match /assessmentResults/{assessmentId} {
      allow read:  if isPortal();
      allow write: if isAdmin();

      match /{tenantId}/students/{userId} {
        allow read:   if isPortal() || (isSignedIn() && request.auth.uid == userId);
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.tenantId == myTenant();
        allow update: if isPortal()
          || (isSignedIn()
              && request.auth.uid == userId
              && request.resource.data.tenantId == myTenant()
              && resource.data.get('status', '') != 'submitted');
        allow delete: if isAdmin();
      }

      match /{tenantId}/guests/{guestId} {
        allow create: if true;
        allow read:   if isPortal() || !isSignedIn();
        allow update, delete: if isPortal();
      }
    }

    // CollectionGroup: students
    // Matches assessmentResults/{assessmentId}/{tenantId}/students/{userId}
    match /{path=**}/students/{userId} {
      allow read: if isAdmin()
        || (isStaff() && resource.data.get('tenantId', '') == myTenant())
        || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.tenantId == myTenant();
      allow update: if isPortal()
        || (isSignedIn()
            && request.auth.uid == userId
            && resource.data.get('status', '') != 'submitted');
      allow delete: if isAdmin();
    }

    // CollectionGroup: guests
    match /{path=**}/guests/{guestId} {
      allow create: if true;
      allow read:   if isPortal();
      allow update, delete: if isPortal();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 9. Tenant Results — reporting projection
    //   tenantResults/{tenantId}/{assessmentId}/{userId}
    //
    // NEW structure (v3): assessmentId is the sub-collection name, userId is the doc key.
    // Student may setDoc ONLY their own row in their own tenant's assessment sub-collection.
    // ══════════════════════════════════════════════════════════════════════

    match /tenantResults/{tenantId} {
      allow read:  if isAdmin() || (isStaff() && tenantAllowed(tenantId));
      allow write: if false;

      match /{assessmentId}/{userId} {
        allow read: if isAdmin()
          || (isStaff() && tenantAllowed(tenantId));
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.tenantId == myTenant()
          && request.resource.data.assessmentId == assessmentId;
        allow delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 10. Proctoring Logs
    //   proctoringLogs/{attemptId}/events/{eventId}
    //   attemptId = {assessmentId}_{userId}
    //
    // Append-only for students. Portal can read/manage.
    // ══════════════════════════════════════════════════════════════════════

    match /proctoringLogs/{attemptId} {
      allow read: if isPortal()
        || (isSignedIn() && attemptId.matches('.*_' + request.auth.uid));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isPortal();
      allow delete: if isAdmin();

      match /events/{eventId} {
        allow read: if isPortal()
          || (isSignedIn() && attemptId.matches('.*_' + request.auth.uid));
        allow create: if isSignedIn();   // student creates events; ownership inferred from attemptId
        allow update: if false;          // append-only
        allow delete: if isAdmin();
      }
    }

    // CollectionGroup: events (Reports/Violations tab)
    match /{path=**}/events/{eventId} {
      allow read:   if isPortal();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 11. Coding Progress  codingProgress/{uid}
    // FIX F: was isSignedIn() globally — any student could read/write any other.
    // ══════════════════════════════════════════════════════════════════════

    match /codingProgress/{uid} {
      allow read, write: if isUser(uid) || isPortal();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 12. Module Assignments
    //   moduleAssignments/{assignmentId}
    //
    // Written by Admin Hub. Read by portal for reporting.
    // Students do NOT need to read this collection directly —
    // they resolve their tests from tenants/{t}/cohorts/{c}.allowedModules.
    // ══════════════════════════════════════════════════════════════════════

    match /moduleAssignments/{assignmentId} {
      allow read:  if isPortal();
      allow write: if isPortal();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 13. Coding Challenges Bank
    // FIX B: list blocked for students. get() allowed (active exam needs
    // challenge data by ID). CDN is the primary source.
    // ══════════════════════════════════════════════════════════════════════

    match /codingChallenges/{challengeId} {
      allow get:    if isSignedIn();
      allow list:   if isPortal();
      allow create, update, delete: if isPortal();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 14. Question Bank (MCQ questions)
    // FIX B: list blocked for students. CDN is the primary source.
    // ══════════════════════════════════════════════════════════════════════

    match /questionBank/{questionId} {
      allow get:    if isSignedIn();
      allow list:   if isPortal();
      allow create, update, delete: if isPortal();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 15. User Solutions
    //   userSolutions/{uid}/solutions/{questionId}
    //   userSolutions/{uid}/allSubmissions/{autoId}
    // ══════════════════════════════════════════════════════════════════════

    match /userSolutions/{uid}/{sub=**} {
      allow read, write: if isUser(uid) || isPortal();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 16. Live Presence (SEB heartbeat)
    //   livePresence/{dateStr}/sessions/{sessionId}
    //
    // FIX: reads restricted to portal. Students write own session only.
    // ══════════════════════════════════════════════════════════════════════

    match /livePresence/{dateStr}/sessions/{sessionId} {
      allow read:   if isPortal();
      allow create: if isSignedIn()
        && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if isPortal()
        || (isSignedIn()
            && resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isPortal();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 17. Content URLs Registry
    // ══════════════════════════════════════════════════════════════════════

    match /contentUrls/{urlId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isPortal();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 18. System Config
    // ══════════════════════════════════════════════════════════════════════

    match /systemConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 19. User API Keys
    // Keyed by email (legacy). Rule covers email + UID during transition.
    // ══════════════════════════════════════════════════════════════════════

    match /userApiKeys/{docId} {
      allow read, write: if isSignedIn()
        && (request.auth.token.email == docId || request.auth.uid == docId);
      allow read, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 20. Guest Assessment Registry  tenantAssessments (FROZEN)
    // No new data goes here. Admin reads for audit only.
    // ══════════════════════════════════════════════════════════════════════

    match /tenantAssessments/{tenantId} {
      allow read:  if isAdmin();
      allow write: if false;

      match /guestTests/{testId} {
        allow read:  if isAdmin();
        allow write: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // LEGACY PATHS — EXPLICITLY BLOCKED
    // ══════════════════════════════════════════════════════════════════════

    // AssessmentResults v1 deep path
    match /AssessmentResults/{testId}/colleges/{college}/years/{year}/students/{email} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Legacy college-based result tree
    match /colleges/{college}/years/{year}/departments/{dept}/students/{email}/{resultType}/{testId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Legacy live users (replaced by livePresence)
    match /LiveUsers/{dateStr}/colleges/{college}/years/{year}/users/{email} {
      allow read:  if isPortal();
      allow write: if false;
    }

    // Legacy proctor logs (replaced by proctoringLogs)
    match /proctor_logs/{studentId}/{testId}/{docId=**} {
      allow read:  if isPortal();
      allow write: if false;
    }

  }
}
